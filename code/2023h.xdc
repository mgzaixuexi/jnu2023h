set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN G21} [get_ports {ad_data_1[2]}] 
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN E19} [get_ports {ad_data_1[1]}] 
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN D19} [get_ports {ad_data_1[0]}] 
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN M21} [get_ports ad_clk_1]

set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN U7} [get_ports {ad_data_2[7]}] 
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN AB7} [get_ports {ad_data_2[6]}] 
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN V7} [get_ports {ad_data_2[5]}] 
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN AB6} [get_ports {ad_data_2[4]}] 
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN AB8} [get_ports {ad_data_2[3]}] 
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN AA8} [get_ports {ad_data_2[2]}] 
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN Y8} [get_ports {ad_data_2[1]}] 
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN Y7} [get_ports {ad_data_2[0]}] 
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN Y9} [get_ports ad_clk_2]

#DA接口
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN D17} [get_ports {da_data_1[7]}] 
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN E17} [get_ports {da_data_1[6]}] 
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN F18} [get_ports {da_data_1[5]}] 
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN F21} [get_ports {da_data_1[4]}] 
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN M18} [get_ports {da_data_1[3]}] 
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN L18} [get_ports {da_data_1[2]}] 
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN H20} [get_ports {da_data_1[1]}] 
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN G20} [get_ports {da_data_1[0]}] 
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN N22} [get_ports da_clk_1]

set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN N13} [get_ports {da_data_2[7]}] 
set_property -dict {IOSTANDARD LVCMOS33 PACKAGE_PIN N14} [get_ports {da_data_2[6]}] 
